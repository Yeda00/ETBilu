<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Menu.uss" />
    <ui:VisualElement name="menu" class="menu">

        <!-- The logo, then the ship (a picture of the 3D showcase, drawn above the logo), then the screens. -->
        <ui:VisualElement name="logo" class="logo" picking-mode="Ignore" />
        <ui:VisualElement name="ship-view" class="ship-view" picking-mode="Ignore" />

        <ui:VisualElement name="screen-title" class="screen">
            <ui:Label name="press-start" class="press-start" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-main" class="screen hidden">
            <ui:VisualElement name="main-list" class="bar-list list-left" />
            <ui:Label name="main-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-sound" class="screen hidden">
            <ui:Label name="sound-title" class="bar title-bar" />
            <ui:VisualElement name="sound-rows" class="sound-rows" />
            <ui:Label name="sound-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-controls" class="screen hidden">
            <ui:Label name="controls-title" class="bar title-bar" />
            <ui:VisualElement name="controls-grid" class="panel ctl-grid" />
            <ui:Label name="controls-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-language" class="screen hidden">
            <ui:Label name="language-title" class="bar title-bar" />
            <ui:VisualElement name="language-list" class="bar-list" />
            <ui:Label name="language-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-credits" class="screen hidden">
            <ui:Label name="credits-title" class="bar title-bar" />
            <ui:ScrollView name="credits-scroll" class="panel credits-scroll">
                <ui:Label name="credits-body" class="credits-body" />
            </ui:ScrollView>
            <ui:Label name="credits-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-missions" class="screen hidden">
            <ui:Label name="missions-title" class="bar title-bar" />
            <ui:VisualElement name="map" class="map" />
            <ui:VisualElement name="mission-info" class="mission-info">
                <ui:Label name="mission-number" class="mission-number" />
                <ui:Label name="mission-place" class="mission-place" />
                <ui:Label name="mission-title" class="mission-title" />
            </ui:VisualElement>
            <ui:Label name="missions-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-intro" class="screen hidden">
            <ui:VisualElement name="intro-picture" class="intro-picture" />
            <ui:VisualElement name="intro-viewport" class="intro-viewport">
                <ui:Label name="intro-text" class="intro-text" />
            </ui:VisualElement>
            <ui:Label name="intro-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>

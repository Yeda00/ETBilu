/* The card shown when a stage starts: "Missão Nº 1", where it happens, and its name. */
.card {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
    -unity-font-style: bold;
}
.card.hidden { display: none; }
.card-number { color: rgb(255, 255, 255); font-size: 76px; letter-spacing: 8px; opacity: 0; }
.card-place { color: rgb(150, 190, 255); font-size: 40px; letter-spacing: 6px; margin-top: 44px; opacity: 0; }
.card-title { color: rgb(255, 226, 70); font-size: 52px; letter-spacing: 6px; margin-top: 56px; opacity: 0; }

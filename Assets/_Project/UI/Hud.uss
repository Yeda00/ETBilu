/* Placeholder HUD. Colours follow GDD 08: cyan = you, violet = echo, orange/red = danger. */

.hud {
    flex-grow: 1;
    padding: 24px 32px;
    justify-content: space-between;
    -unity-font-style: bold;
}

.top { flex-direction: row; justify-content: space-between; }
.left, .right { width: 420px; }
.right { align-items: flex-end; }
.row { flex-direction: row; align-items: center; margin-top: 4px; }

.caption { font-size: 13px; letter-spacing: 2px; margin: 10px 0 4px 0; padding: 0; }
.caption.integrity { color: rgb(63, 224, 160); }
.caption.memory { color: rgb(255, 77, 109); }
.caption.score { color: rgb(54, 226, 255); }
.caption.echo { color: rgb(177, 140, 255); margin-top: 14px; }
.caption.gadget { color: rgb(54, 226, 255); margin-top: 14px; }
.caption.boss { color: rgb(255, 138, 61); -unity-text-align: middle-center; }

.bar {
    width: 220px;
    height: 12px;
    background-color: rgba(19, 34, 69, 0.85);
    border-radius: 2px;
    overflow: hidden;
}
.bar.wide { width: 260px; }
.fill { height: 100%; width: 100%; }
.fill.integrity { background-color: rgb(63, 224, 160); }
.fill.memory { background-color: rgb(255, 77, 109); width: 0%; }
.fill.memory.ready { background-color: rgb(177, 140, 255); }
.fill.gadget { background-color: rgb(54, 226, 255); }
.fill.gadget.charging { background-color: rgb(42, 58, 99); }
.fill.boss { background-color: rgb(255, 138, 61); }
.fill.boss.vulnerable { background-color: rgb(255, 77, 109); }

/* Boss panel: top centre, shown only while the Guardian is on screen. */
.boss { width: 420px; align-items: center; }
.boss.hidden { display: none; }
.bar.boss { width: 400px; height: 14px; }
.boss-phase { color: rgb(255, 201, 161); font-size: 13px; letter-spacing: 2px; margin-top: 2px; }
.pip {
    width: 12px; height: 12px; margin-right: 6px; border-radius: 2px;
    rotate: 45deg;
    background-color: rgb(255, 138, 61);
}
.pip.down { background-color: rgb(42, 58, 99); }
.pip.teeth { background-color: rgb(255, 235, 140); }
.pip.teeth.down { background-color: rgb(42, 58, 99); }
.pip.guarded { opacity: 0.4; }

.value { color: rgb(230, 236, 255); font-size: 14px; margin-left: 10px; }
.state { color: rgb(201, 212, 242); font-size: 13px; -unity-font-style: normal; }

.rec-dot {
    width: 10px; height: 10px; border-radius: 5px; margin-right: 8px;
    background-color: rgb(42, 58, 99);
}
.rec-dot.on { background-color: rgb(255, 77, 109); }

.score-value { color: rgb(230, 236, 255); font-size: 34px; margin: 0; padding: 0; }

.slots { flex-direction: row; }
.slot {
    width: 108px; height: 54px; margin-left: 8px; padding: 6px 10px;
    border-radius: 8px; border-width: 1px;
    border-color: rgb(36, 52, 95);
    background-color: rgba(15, 24, 48, 0.85);
}
.slot.playing { border-color: rgb(177, 140, 255); background-color: rgba(28, 22, 64, 0.9); }
.slot.locked { opacity: 0.35; }
.slot-name { color: rgb(201, 212, 242); font-size: 13px; margin: 0; padding: 0; }
.slot-state { color: rgb(93, 111, 158); font-size: 12px; -unity-font-style: normal; margin: 2px 0 0 0; padding: 0; }
.slot.playing .slot-state { color: rgb(177, 140, 255); }

/* Combo notice (GDD 03): pops up for a moment when a temporal combo lands, as in the HUD mockup. */
.combo {
    position: absolute; left: 0; right: 0; top: 24%;
    align-items: center;
    transition-property: opacity, scale;
    transition-duration: 0.12s, 0.18s;
}
.combo.hidden { opacity: 0; scale: 0.8 0.8; }
.combo-title { color: rgb(255, 138, 61); font-size: 34px; letter-spacing: 5px; margin: 0; padding: 0; }
.combo.strike .combo-title { font-size: 40px; }
.combo-hint { color: rgb(255, 201, 161); font-size: 14px; letter-spacing: 2px; -unity-font-style: normal; margin: 2px 0 0 0; padding: 0; }

.message {
    position: absolute; left: 14%; right: 14%; top: 34%;
    padding: 26px 36px 28px 36px;
    align-items: center;
    background-color: rgba(7, 8, 28, 0.92);
    border-width: 2px;
    border-color: rgba(255, 138, 61, 0.6);
}
.message.victory {
    border-width: 3px;
    border-color: rgb(54, 226, 255);
    background-color: rgba(7, 12, 34, 0.96);
}
.message.hidden { display: none; }
.message-title { color: rgb(255, 138, 61); font-size: 46px; letter-spacing: 6px; margin: 0; }
.message.victory .message-title { color: rgb(255, 226, 70); font-size: 50px; }
.message-subtitle { color: rgb(54, 226, 255); font-size: 18px; letter-spacing: 4px; margin-top: 8px; }
.message-hint { color: rgb(255, 201, 161); font-size: 16px; letter-spacing: 1px; margin-top: 12px; -unity-font-style: normal; }
.message-return { color: rgb(201, 212, 242); font-size: 14px; letter-spacing: 2px; margin-top: 18px; -unity-font-style: normal; }

.hint { align-self: center; color: rgba(138, 155, 196, 0.85); font-size: 12px; -unity-font-style: normal; }

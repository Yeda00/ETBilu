    - rid: 8629141398965715091
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Shown when the player tries to change a fixed control (the
          mouse aim, for instance).
    - rid: 8629141398965715092
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Hint under the scrolling story.
    - rid: 8629141398965715093
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'HUD caption: the health bar of the ship.'
    - rid: 8629141398965715094
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'HUD caption: how long the ship can record the echo.'
    - rid: 8629141398965715095
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: HUD caption.
    - rid: 8629141398965715096
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'HUD caption: name of the boss (provisional).'
    - rid: 8629141398965715097
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: HUD caption.
    - rid: 8629141398965715098
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'HUD caption: the list of echo slots.'
    - rid: 8629141398965715099
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = slot number, with two digits.'
    - rid: 8629141398965715100
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = seconds recorded, {1} = maximum, in seconds.'
    - rid: 8629141398965715101
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = seconds until the anchor can be planted again.'
    - rid: 8629141398965715102
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The echo can be recorded.
    - rid: 8629141398965715103
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Recording. SHIFT is the default key; the anchor is the point
          the ship returns to.
    - rid: 8629141398965715104
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The anchor is on cooldown.
    - rid: 8629141398965715105
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: SHIFT is the default key.
    - rid: 8629141398965715106
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: An echo is playing and no anchor is available.
    - rid: 8629141398965715107
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'State of an echo slot in use. Short: it sits in a small box.'
    - rid: 8629141398965715108
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'State of a free echo slot. Short: it sits in a small box.'
    - rid: 8629141398965715109
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Q is the default key.
    - rid: 8629141398965715110
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = seconds left.'
    - rid: 8629141398965715111
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Boss phase.
    - rid: 8629141398965715112
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Boss phase: the player takes the boss apart piece by piece.'
    - rid: 8629141398965715113
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Boss state.
    - rid: 8629141398965715114
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Boss state.
    - rid: 8629141398965715115
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Boss state in phase 1: nothing can be hurt yet.'
    - rid: 8629141398965715116
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Boss state: the weak points are open.'
    - rid: 8629141398965715117
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Boss state: the weak points are open.'
    - rid: 8629141398965715118
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Boss state: the weak points are open.'
    - rid: 8629141398965715119
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Boss state: tells which part opens which teeth.'
    - rid: 8629141398965715120
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Name of a combo; kept in English.
    - rid: 8629141398965715121
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: How the Crossfire combo is made.
    - rid: 8629141398965715122
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Name of a combo; kept in English.
    - rid: 8629141398965715123
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: How the Synchronized Strike combo is made.
    - rid: 8629141398965715124
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Title of the pause message.
    - rid: 8629141398965715125
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Under PAUSE.
    - rid: 8629141398965715126
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: The ship was destroyed.
    - rid: 8629141398965715127
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Under TRY AGAIN.
    - rid: 8629141398965715128
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'The boss fell: end of the stage.'
    - rid: 8629141398965715129
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{0} = score, {1} = enemies destroyed, {2} = number of combos,
          {3} = the word ''combo'' or ''combos'' (hud.cleared.combo / .combos).'
    - rid: 8629141398965715130
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{3} of hud.cleared.stats when there is one combo.'
    - rid: 8629141398965715131
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: '{3} of hud.cleared.stats when there are zero or several combos.'
    - rid: 8629141398965715132
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Hint line at the foot of the HUD with a keyboard. Each {n}
          is a key as the player set it: 0 move keys, 1 the word MOUSE, 2 fire key,
          3 the word CLICK, 4 record, 5 dodge, 6 mine, 7 pause.'
    - rid: 8629141398965715133
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Hint line at the foot of the HUD with a gamepad. Each {n}
          is a button: 0 left stick, 1 right stick, 2 fire, 3 record, 4 dodge, 5
          mine, 6 pause.'
    - rid: 8629141398965715134
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Mission card and map: the place, under the mission number.'
    - rid: 8629141398965715135
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Mission card and map: the name of the mission.'
    - rid: 8629141398965715136
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, paragraph 1. Bilu is the hero, an alien.
    - rid: 8629141398965715137
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, paragraph 2.
    - rid: 8629141398965715138
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, paragraph 3.
    - rid: 8629141398965715139
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, paragraph 4.
    - rid: 8629141398965715140
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, paragraph 5.
    - rid: 8629141398965715141
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, last paragraph. 'One more time' is the old name
          of the game.
    - rid: 8629141398965715148
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, paragraph 7.
    - rid: 8629141398965715149
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Story crawl, paragraph 8. 'One more time' is the old name
          of the game.
    - rid: 8629141398965715150
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Story crawl, last line, shouted. It is the message Bilu delivers:
          the pt text is BUSQUEM CONHECIMENTO!!!!'
    - rid: 8629141398965715153
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Main title of the end-of-game victory card.
    - rid: 8629141398965715154
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Countdown on the end-of-game victory card. {0} = seconds remaining.

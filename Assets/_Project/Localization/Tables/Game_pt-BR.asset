      m_Items: []
  - m_Id: 464511025
    m_Localized: "\u2191 \u2193 \u2190 \u2192 ESCOLHE  \xB7  ENTER OU A MUDA  \xB7 
      ESC OU B VOLTA"
    m_Metadata:
      m_Items: []
  - m_Id: 464511026
    m_Localized: "APERTE O NOVO BOT\xC3O  \xB7  ESC CANCELA"
